def template SpMMMERGEDeclare {{

template<typename ElemType>
class %(class_name)s : public %(base_class)s
{
private:
    RegId srcRegIdxArr[3];
    RegId destRegIdxArr[0];
public:
    %(class_name)s(ExtMachInst _machInst, uint32_t _vlen);
    Fault execute(ExecContext* xc, trace::InstRecord* traceData)const override;
    using %(base_class)s::generateDisassembly;
};

}};

def template SpMMMERGEConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst, uint32_t _vlen)
    : %(base_class)s("%(mnemonic)s", _machInst,
        %(op_class)s, 8*sizeof(ElemType), _vlen)
{
    %(set_reg_idx_arr)s;
    _numSrcRegs = 0;
    _numDestRegs = 0;
    setSrcRegIdx(_numSrcRegs++, intRegClass[_machInst.rd]);
    setSrcRegIdx(_numSrcRegs++, intRegClass[_machInst.rs1]);
    setSrcRegIdx(_numSrcRegs++, intRegClass[_machInst.rs2]);
}

%(declare_spmm_template)s

}};

def template SpMMMERGEExecute {{

template <typename ElemType>
Fault
%(class_name)s<ElemType>::execute(ExecContext* xc,
                                  trace::InstRecord* traceData) const
{
    using et = ElemType;
    using vu = decltype(et::v);

    %(op_decl)s;
    %(op_rd)s;

    uint32_t index0, index1, index_d;

    %(code)s;

    RiscvISAInst::SpMMRegContainer data0;
    RiscvISAInst::SpMMRegContainer data1;
    auto tmp0 = data0.as<vu>();
    auto tmp1 = data1.as<vu>();

    xc->readSpMMBuffer(index0, data0.as<uint8_t>());
    xc->readSpMMBuffer(index1, data1.as<uint8_t>());

    uint32_t e_num = vlen / elen;

    for (size_t i = 0; i < e_num; i++) {
        auto fd = fadd<et>(
            ftype<et>(tmp0[i]), ftype<et>(tmp1[i]));
        tmp0[i] = fd.v;
    }

    xc->writeSpMMBuffer(index_d, data0.as<uint8_t>());

    %(op_wb)s;

    return NoFault;
}

%(declare_spmm_template)s

}};

def template STRESDeclare {{

template<typename ElemType>
class %(class_name)s : public %(base_class)s
{
private:
    RegId srcRegIdxArr[2];
    RegId destRegIdxArr[0];
public:
    %(class_name)s(ExtMachInst _machInst, uint32_t _vlen);
    Fault execute(ExecContext *, trace::InstRecord *) const override;
    Fault initiateAcc(ExecContext *, trace::InstRecord *) const override;
    Fault completeAcc(PacketPtr, ExecContext *,
                      trace::InstRecord *) const override;
    using %(base_class)s::generateDisassembly;
};

}};

def template STRESConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst, uint32_t _vlen)
    : %(base_class)s("%(mnemonic)s", _machInst,
                    %(op_class)s, 8*sizeof(ElemType), _vlen)
{
    %(set_reg_idx_arr)s;
    _numSrcRegs = 0;
    _numDestRegs = 0;
    setSrcRegIdx(_numSrcRegs++, intRegClass[_machInst.rd]);
    setSrcRegIdx(_numSrcRegs++, intRegClass[_machInst.rs1]);

    this->flags[IsStore] = true;
    this->setDelayedCommit();
    this->setFlag(IsStore);
}

%(declare_spmm_template)s

}};

def template STRESExecute {{

template<typename ElemType>
Fault
%(class_name)s<ElemType>::execute(ExecContext *xc,
    trace::InstRecord *traceData) const
{
    Addr EA;
    uint32_t index;
    uint32_t mem_size = vlen >> 3;
    uint8_t* b_data = new uint8_t[mem_size];

    %(op_decl)s;
    %(op_rd)s;
    %(ea_code)s;

    xc->readSpMMBuffer(index, b_data);

    for (size_t i = 0; i < mem_size; i++) {
        %(memacc_code)s;
    }

    const std::vector<bool> byte_enable(mem_size, true);
    Fault fault = xc->writeMem(Mem.as<uint8_t>(), mem_size, EA,
                               memAccessFlags, nullptr, byte_enable);

    delete [] b_data;

    if (fault != NoFault)
        return fault;

    %(op_wb)s;

    return NoFault;
}

%(declare_spmm_template)s

}};

def template STRESInitiateAcc {{

template<typename ElemType>
Fault
%(class_name)s<ElemType>::initiateAcc(ExecContext* xc,
                            trace::InstRecord* traceData) const
{
    Addr EA;
    uint32_t index;
    uint32_t mem_size = vlen >> 3;

    %(op_decl)s;
    %(op_rd)s;

    %(ea_code)s;

    uint8_t* b_data = new uint8_t[mem_size];
    xc->readSpMMBuffer(index, b_data);

    for (size_t i = 0; i < mem_size; i++) {
        %(memacc_code)s;
    }

    const std::vector<bool> byte_enable(mem_size, true);
    Fault fault = xc->writeMem(Mem.as<uint8_t>(), mem_size, EA,
                               memAccessFlags, nullptr, byte_enable);
    delete [] b_data;
    return fault;
}

}};

def template STRESCompleteAcc {{

template<typename ElemType>
Fault
%(class_name)s<ElemType>::completeAcc(PacketPtr pkt, ExecContext *xc,
                            trace::InstRecord *traceData) const
{
    return NoFault;
}

}};
