def template LDPRFMacroConstructor {{

template<typename ElemType>
%(class_name)s<ElemType>::%(class_name)s(ExtMachInst _machInst, uint32_t _vlen)
    : %(base_class)s("%(mnemonic)s", _machInst,
        %(op_class)s, 8*sizeof(ElemType), _vlen)
{
    %(set_reg_idx_arr)s;
    %(constructor)s;

    this->microops.push_back(new LDPRFMicro1<ElemType>(_machInst, vlen));
    this->microops.push_back(new LDPRFMicro2<ElemType>(_machInst, vlen));

    this->microops.front()->setFirstMicroop();
    this->microops.back()->setLastMicroop();
}

%(declare_spmm_template)s

}};

